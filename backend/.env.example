PORT=5001
MONGODB_URI=<replace-me>
# message EM for URI
FRONTEND_ORIGIN="http://localhost:3000"
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
# message EM for service account key file

# --- Contact form email (Nodemailer / SMTP) ---
# Example (Mailtrap): SMTP_HOST=sandbox.smtp.mailtrap.io, SMTP_PORT=587, SMTP_SECURE=false
SMTP_HOST=<replace-me>
SMTP_PORT=<replace-me>
SMTP_SECURE=false
SMTP_USER=<replace-me>
SMTP_PASS=<replace-me>
SMTP_FROM="CRED Website <no-reply@credsd.org>"
# Defaults to credsd@credsd.org if omitted.
CONTACT_TO="credsd@credsd.org"
